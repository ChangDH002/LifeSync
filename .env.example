MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=dementia_app
REQUIRE_DB_ON_STARTUP=false
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Social login (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
SOCIAL_STATE_SECRET=replace-with-a-long-random-secret
# Allowlist must contain exact frontend callback URIs, not just origins.
SOCIAL_REDIRECT_ALLOWLIST=http://localhost:5173/auth/callback/google,http://127.0.0.1:5173/auth/callback/google,http://localhost:5173/auth/callback/kakao,http://127.0.0.1:5173/auth/callback/kakao,http://localhost:5174/auth/callback/google,http://127.0.0.1:5174/auth/callback/google,http://localhost:5174/auth/callback/kakao,http://127.0.0.1:5174/auth/callback/kakao

# Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SBERT / 데이터셋
SBERT_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SBERT_DATASET_PATH=app/data/dementia_question_dataset_7000.csv

# Development-only seeded account
ENABLE_DEV_SEED_USER=false
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_NAME=개발용 테스트 사용자
